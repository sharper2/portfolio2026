    ],
  },
  {
    title: 'Game Dev',
    id: 'game-dev',
    skills: [
      {
        name: 'Unity',
        icon: 'unity',
        experience: [
          {
            title: 'Temporal Stasis',
            detail: 'Gameplay programming and level design for a 2D puzzle platformer at Game I/O 2026.',
            href: `${base}projects/temporal-stasis`,
          },
          {
            title: 'Dungeon Generator',
            detail: 'Reusable Unity library for procedural, tile-based dungeon generation (Unity 6).',
            href: `${base}projects/dungeon-generator`,
          },
        ],
      },
      {
        name: 'MonoGame',
        icon: 'monogame',
        experience: [
          {
            title: 'Super Mario Bros. 3 Recreation',
            detail: 'CSE 3902 group project recreating SMB3 in MonoGame and C#.',
          },
          {
            title: 'Peggle-like Physics Demo',
            detail: '2D physics sandbox built to learn Newtonian simulation basics.',
            href: 'https://github.com/sharper2/peggleLike',
          },
        ],
      },
    ],
  },
  {
    title: 'Workflow',
    id: 'workflow',
