---
import SkillIcon from './SkillIcon.astro';
import type { SkillIconId } from '../lib/skill-icons';

const base = import.meta.env.BASE_URL;

type SkillExperience = {
  title: string;
  detail: string;
  href?: string;
};

type Skill = {
  name: string;
  icon: SkillIconId;
  experience: SkillExperience[];
};

type SkillGroup = {
  title: string;
  id: string;
  skills: Skill[];
};

const skillGroups: SkillGroup[] = [
  {
    title: 'Languages',
    id: 'languages',
    skills: [
      {
        name: 'C#',
        icon: 'csharp',
        experience: [
          {
            title: 'Super Mario Bros. 3 Recreation',
            detail: 'CSE 3902 group project in MonoGame — gameplay, collision, and level systems.',
          },
          {
            title: 'Peggle-like Physics Demo',
            detail: 'MonoGame exercise implementing a basic Newtonian physics engine.',
            href: 'https://github.com/sharper2/peggleLike',
          },
          {
            title: 'Dungeon Generator',
            detail: 'Standalone Unity library for procedural dungeon generation.',
            href: `${base}projects/dungeon-generator`,
          },
        ],
      },
      {
        name: 'Java',
        icon: 'java',
        experience: [
          {
            title: 'Ohio State coursework',
            detail: 'Data structures, software design, and object-oriented projects in Java.',
          },
        ],
      },
      {
        name: 'TypeScript',
        icon: 'typescript',
        experience: [
          {
            title: 'Sam Harper Homepage',
            detail: 'Personal site built with Astro, Tailwind CSS, and TypeScript.',
            href: 'https://samharper.net/projects/sam-homepage',
          },
          {
            title: 'CCHMC internship',
            detail: 'TypeScript on internal web applications alongside React.',
          },
        ],
      },
      {
        name: 'JavaScript',
        icon: 'javascript',
        experience: [
          {
            title: 'Web coursework & projects',
            detail: 'Fundamentals through advanced front-end work in JavaScript.',
          },
          {
            title: 'CCHMC internship',
            detail: 'JavaScript and TypeScript on production internal apps.',
          },
        ],
      },
      {
        name: 'C',
        icon: 'c',
        experience: [
          {
            title: 'Ohio State coursework',
            detail: 'Introductory and systems-oriented programming in C.',
          },
        ],
      },
    ],
  },
  {
    title: 'Web',
    id: 'web',
    skills: [
      {
        name: 'React',
        icon: 'react',
        experience: [
          {
            title: 'CCHMC internship',
            detail: 'Primary framework for most internal apps I work on.',
          },
          {
            title: 'REST APIs',
            detail: 'Consuming internal APIs with standard HTTP request patterns for data and forms.',
          },
        ],
      },
      {
        name: 'Material UI',
        icon: 'mui',
        experience: [
          {
            title: 'CCHMC internship',
            detail: 'Component library on most React apps — layouts, forms, and data display.',
          },
        ],
      },
      {
        name: 'Angular',
        icon: 'angular',
        experience: [
          {
            title: 'CCHMC internship',
            detail: 'Dedicated Angular project with substantial hands-on feature work.',
          },
        ],
      },
      {
        name: 'Radix UI',
        icon: 'radix',
        experience: [
          {
            title: 'CCHMC internship',
            detail: 'Sole frontend developer on a project — built the UI with Radix primitives.',
          },
          {
            title: 'REST APIs',
            detail: 'Integrated frontend components with internal HTTP APIs.',
