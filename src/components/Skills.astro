function chunkSkills<T>(items: T[], size: number): T[][] {
  const rows: T[][] = [];

  for (let i = 0; i < items.length; i += size) {
    rows.push(items.slice(i, i + size));
  }

  return rows;
}
---

<section class="skills" id="skills">
  <div class="section-inner">
    <h2><span>Skills &amp; Experience</span></h2>
    <p class="skills__intro">
      Click a skill to see where I've used it. Links go to project writeups when available.
    </p>

    <div class="skills-groups skills-groups--desktop">
      {skillGroups.map((group) => (
        <details class="skills-group" open>
          <summary class="skills-group__summary">
            <span class="skills-group__title">{group.title}</span>
          </summary>

          <div class="skills-group__content">
            <div class="skills-group__content-inner">
              <div class="skills-grid skills-grid--desktop">
                {group.skills.map((skill) => (
                  <details class="skill-item">
                    <summary class="skill-item__trigger">
                      <span class="skill-item__icon">
                        <SkillIcon icon={skill.icon} />
                      </span>
                      <span class="skill-item__label">{skill.name}</span>
                    </summary>

                    <div class="skill-item__dropdown">
                      <div class="skill-item__dropdown-inner">
                        <SkillExperienceList experience={skill.experience} />
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>

    <div class="skills-groups skills-groups--mobile">
      {skillGroups.map((group) => (
        <details class="skills-group" open>
          <summary class="skills-group__summary">
            <span class="skills-group__title">{group.title}</span>
          </summary>

          <div class="skills-group__content">
            <div class="skills-group__content-inner">
              <div class="skills-mobile">
                {chunkSkills(group.skills, 2).map((row) => (
                  <div class="skills-row" data-skills-row>
                    <div class="skills-row__triggers">
                      {row.map((skill) => (
                        <button
                          type="button"
                          class="skill-item__trigger skill-item__trigger--mobile"
                          data-skill-trigger
                          aria-expanded="false"
                        >
                          <span class="skill-item__icon">
                            <SkillIcon icon={skill.icon} />
                          </span>
                          <span class="skill-item__label">{skill.name}</span>
                        </button>
                      ))}
                      {row.length === 1 && <span class="skills-row__spacer" aria-hidden="true"></span>}
                    </div>

                    <div class="skills-row__dropdown" data-skills-row-dropdown>
                      <div class="skills-row__dropdown-inner">
                        {row.map((skill) => (
                          <div class="skills-row__panel" data-skill-panel hidden>
                            <SkillExperienceList experience={skill.experience} />
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const collapseDurationMs = 470;

  function afterCollapseTransition(element, callback) {
    if (prefersReducedMotion) {
      callback();
      return;
    }

    let finished = false;

    const finish = () => {
      if (finished) return;
      finished = true;
      element.removeEventListener('transitionend', onTransitionEnd);
      window.clearTimeout(fallbackTimer);
      callback();
    };

    const onTransitionEnd = (event) => {
      if (event.target !== element || event.propertyName !== 'grid-template-rows') return;
      finish();
    };

    element.addEventListener('transitionend', onTransitionEnd);
    const fallbackTimer = window.setTimeout(finish, collapseDurationMs);
  }

  document.querySelectorAll('[data-skills-row]').forEach((row) => {
    const dropdown = row.querySelector('[data-skills-row-dropdown]');
    const panels = Array.from(row.querySelectorAll('[data-skill-panel]'));
    const triggers = Array.from(row.querySelectorAll('[data-skill-trigger]'));

    if (!dropdown || panels.length === 0 || triggers.length === 0) return;

    const closeRow = () => {
      triggers.forEach((trigger) => {
        trigger.setAttribute('aria-expanded', 'false');
      });
      dropdown.classList.remove('is-open');

      afterCollapseTransition(dropdown, () => {
        panels.forEach((panel) => {
          panel.hidden = true;
        });
      });
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          closeRow();
          return;
        }

        triggers.forEach((otherTrigger, otherIndex) => {
          const expanded = otherIndex === index;
          otherTrigger.setAttribute('aria-expanded', String(expanded));
          if (panels[otherIndex]) {
            panels[otherIndex].hidden = !expanded;
          }
        });

        dropdown.classList.add('is-open');
      });
    });
  });

  document.querySelectorAll('.skills-group').forEach((details) => {
    const summary = details.querySelector('.skills-group__summary');
    const content = details.querySelector('.skills-group__content');

    if (!summary || !content) return;

    summary.addEventListener('click', (event) => {
      if (!details.open) return;

      event.preventDefault();
      details.classList.add('is-closing');

      afterCollapseTransition(content, () => {
        details.open = false;
        details.classList.remove('is-closing');
      });
    });
  });

  document.querySelectorAll('.skills-grid--desktop .skill-item').forEach((details) => {
    const summary = details.querySelector('summary');
    const dropdown = details.querySelector('.skill-item__dropdown');

    if (!summary || !dropdown) return;

    summary.addEventListener('click', (event) => {
      if (!details.open) return;

      event.preventDefault();
      details.classList.add('is-closing');

      afterCollapseTransition(dropdown, () => {
        details.open = false;
        details.classList.remove('is-closing');
      });
    });
  });
</script>
