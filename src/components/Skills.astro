---
type SkillExperience = {
  title: string;
  detail: string;
};

type Skill = {
  name: string;
  summary: string;
  icon: 'csharp' | 'unity' | 'web' | 'java' | 'c' | 'tools';
  experience: SkillExperience[];
};

const skills: Skill[] = [
  {
    name: 'C#',
    summary: 'Primary language for game projects and classwork.',
    icon: 'csharp',
    experience: [
      {
        title: 'Super Mario Bros. 3 Recreation',
        detail: 'Group project for CSE 3902 built in MonoGame — gameplay, collision, and level systems in C#.',
      },
      {
        title: 'Peggle-like Physics Demo',
        detail: 'MonoGame exercise implementing a basic Newtonian physics engine.',
      },
    ],
  },
  {
    name: 'Unity',
    summary: 'Game jams and reusable library work.',
    icon: 'unity',
    experience: [
      {
        title: 'Temporal Stasis',
        detail: 'Gameplay programming and level design for a 2D puzzle platformer at the 2026 Game I/O jam.',
      },
      {
        title: 'Dungeon Generator',
        detail: 'Standalone Unity library for procedural, tile-based dungeon generation.',
      },
    ],
  },
  {
    name: 'Web Development',
    summary: 'JavaScript, TypeScript, HTML, CSS, and Astro.',
    icon: 'web',
    experience: [
      {
        title: 'Software Engineering Intern',
        detail: "Cincinnati Children's Hospital Medical Center — current role building internal software.",
      },
      {
        title: 'Sam Harper Homepage',
        detail: 'Personal site with blog, interests, and projects — Astro, Tailwind CSS, and TypeScript.',
      },
      {
        title: 'This Portfolio',
        detail: 'Static portfolio site built with Astro and deployed alongside the homepage.',
      },
    ],
  },
  {
    name: 'Java',
    summary: 'Core CS coursework and object-oriented design.',
    icon: 'java',
    experience: [
      {
        title: 'Ohio State coursework',
        detail: 'Data structures, software design, and several projects in Java.',
      },
    ],
  },
  {
    name: 'C',
    summary: 'Low-level programming and systems fundamentals.',
    icon: 'c',
    experience: [
      {
        title: 'Ohio State coursework',
        detail: 'Introductory and systems-oriented programming in C.',
      },
    ],
  },
  {
    name: 'Tools & Other',
    summary: 'Engines, coursework languages, and day-to-day tooling.',
    icon: 'tools',
    experience: [
      {
        title: 'MonoGame',
        detail: 'Primary framework for 2D game projects outside of Unity.',
      },
      {
        title: 'Matlab & Assembly',
        detail: 'Used in engineering and computer architecture coursework.',
      },
    ],
  },
];
---

<section class="skills" id="skills">
  <div class="section-inner">
    <h2><span>Skills &amp; Experience</span></h2>
    <p class="skills__intro">
      Click a skill to see where I've used it. Project writeups live below.
    </p>

    <div class="skills-grid">
      {skills.map((skill) => (
        <details class="skill-card">
          <summary class="skill-card__summary">
            <span class="skill-card__icon" aria-hidden="true">
              {skill.icon === 'csharp' && (
                <svg viewBox="0 0 24 24" fill="currentColor" role="img">
                  <path d="M12 2L2 7.5v9L12 22l10-5.5v-9L12 2zm0 2.2l7.4 4.1v7.4L12 19.8l-7.4-4.1V8.3L12 4.2zM8.8 14.1v-4.2l3.2 1.8 3.2-1.8v4.2l-3.2 1.8-3.2-1.8z" />
                </svg>
              )}
              {skill.icon === 'unity' && (
                <svg viewBox="0 0 24 24" fill="currentColor" role="img">
                  <path d="M12 2.2 2.5 7.1v9.8L12 22l9.5-5.1V7.1L12 2.2zm0 2.3 6.8 3.7v7.6L12 19.5l-6.8-3.7V8.2L12 4.5zM8.5 9.4v5.2L12 16.8l3.5-2.2V9.4L12 7.2 8.5 9.4z" />
                </svg>
              )}
              {skill.icon === 'web' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" role="img">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
                </svg>
              )}
              {skill.icon === 'java' && (
                <svg viewBox="0 0 24 24" fill="currentColor" role="img">
                  <path d="M8.5 18.5c-.3.4 1.1.7 2.4.5.9-.1 2.8-.8 2.8-.8s-.5.3-1.3.5c-2.1.6-4.4.2-3.9-.2zm-1-2.8c-.2.5 1 .9 2.2.9 1.1 0 2.9-.4 2.9-.4s-.4.4-1.2.6c-2 .5-4.5.2-3.9-.5zm6.4-3.2c.8 1.1-2.1 2.1-2.1 2.1s4.3-.7 2.1-2.1zm-8.2-1.2c.1.9-1.6 1.6-1.6 1.6s2.7-.4 1.6-1.6zm11.4 0c-1.1 1.2 1.6 1.6 1.6 1.6s-1.7-.7-1.6-1.6zM12 4.8c0 0-3.6 1.8-1.9 5.8.5 1 .7 1.5.7 1.5s-.4-.2-.9-.8c-.4-.5-.7-1.2-.7-2 0-2.2 2.8-2.8 2.8-2.8S14.6 7 14.6 9.3c0 .8-.3 1.5-.7 2-.5.6-.9.8-.9.8s.2-.5.7-1.5c1.7-4-1.9-5.8-1.9-5.8z" />
                </svg>
              )}
              {skill.icon === 'c' && (
                <svg viewBox="0 0 24 24" fill="currentColor" role="img">
                  <path d="M16.5 8.5c-1.2-1.4-3-2.2-5-2.2-3.8 0-6.8 3.1-6.8 6.8s3.1 6.8 6.8 6.8c2 0 3.8-.8 5-2.2l1.5 1.5C16.8 20.7 14.4 21.5 12 21.5 6.9 21.5 2.5 17.1 2.5 12S6.9 2.5 12 2.5c2.4 0 4.8.8 6.5 2.5L16.5 8.5z" />
                </svg>
              )}
              {skill.icon === 'tools' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" role="img">
                  <path d="M14.7 6.3a4.5 4.5 0 0 0-6.2 6.2L3 18l3 3 5.5-5.5a4.5 4.5 0 0 0 6.2-6.2l-2.2 2.2-3.8-3.8 2.2-2.2z" />
                </svg>
              )}
            </span>
            <span class="skill-card__text">
              <span class="skill-card__name">{skill.name}</span>
              <span class="skill-card__blurb">{skill.summary}</span>
            </span>
            <span class="skill-card__chevron" aria-hidden="true"></span>
          </summary>

          <ul class="skill-card__experience">
            {skill.experience.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.detail}</span>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </div>
</section>
