          {
            title: 'Azure DevOps',
            detail: 'Also worked around existing Azure DevOps pipelines — YAML edits and config updates.',
          },
        ],
      },
      {
        name: 'Agile / Scrum',
        icon: 'agile',
        experience: [
          {
            title: 'CCHMC internship',
            detail: 'Sprint planning, standups, and task tracking in an Agile team environment.',
          },
