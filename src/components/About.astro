---
import { assetUrl } from '../lib/asset-url';

const base = import.meta.env.BASE_URL;

const MOHER_WIDTH = 1168;
const MOHER_HEIGHT = 1340;

const photos = [
  {
    src: assetUrl(base, 'images/sam-moher.jpeg'),
    alt: 'Sam Harper at the Cliffs of Moher',
    width: MOHER_WIDTH,
    height: MOHER_HEIGHT,
    crop: 'moher',
  },
  {
    src: assetUrl(base, 'images/sam-kilkenny.jpeg'),
    alt: 'Sam Harper in Kilkenny',
    width: 4032,
    height: 3024,
    crop: 'kilkenny',
  },
];
---

<section class="about-me" id="about">
  <div class="section-inner">
    <h2><span>About Me</span></h2>

    <div class="about-me__layout">
      <figure
        class="about-me__photo"
        data-photo-rotate={photos.length > 1}
        style={`aspect-ratio: ${MOHER_WIDTH} / ${MOHER_HEIGHT}`}
      >
        {photos.map((photo, index) => (
          <img
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            data-photo-index={index}
            class:list={[
              'about-me__photo-img',
              `about-me__photo-img--${photo.crop}`,
              { 'is-active': index === 0 },
            ]}
          />
        ))}
      </figure>

      <div class="about-me__content">
        <p>
          I'm a software engineer and game developer studying Computer Science &amp; Engineering at
          The Ohio State University, with a specialization in Computer Graphics &amp; Game Design.
          I like building things that feel good to use — whether that's a web app, a game system,
          or a small tool that saves someone five minutes.
        </p>
        <p>
          Right now I'm working as a Software Engineering Intern at Cincinnati Children's Hospital
          Medical Center. Outside of work and school, I'm a trombonist in The Ohio State University
          Marching Band, and I spend a lot of time playing games, reading, writing, and making things.
        </p>

        <div class="about-me__education">
          <div class="about-me__education-header">
            <img
              src={assetUrl(base, 'icons/ohio-state.svg')}
              alt=""
              class="about-me__education-logo"
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
            />
            <h3>Education</h3>
          </div>
          <p>
            <strong>The Ohio State University</strong> — B.S. Computer Science &amp; Engineering,
            Computer Graphics &amp; Game Design specialization · Expected Spring 2028
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{photos.length > 1 && (
  <script>
    const figure = document.querySelector<HTMLElement>('.about-me__photo[data-photo-rotate="true"]');
    if (!figure) throw new Error('Photo figure not found');

    const images = Array.from(figure.querySelectorAll<HTMLImageElement>('.about-me__photo-img'));
    if (images.length < 2) throw new Error('Not enough images to rotate');

    let activeIndex = 0;

    const showPhoto = (index: number) => {
      images[activeIndex]?.classList.remove('is-active');
      activeIndex = index;
      images[activeIndex]?.classList.add('is-active');
    };

    window.setInterval(() => {
      showPhoto((activeIndex + 1) % images.length);
    }, 6000);
  </script>
)}
